# Celatlas v1.8 portable configuration template.
#
# Copy one of these:
#   cp configs/celatlas.env.example configs/celatlas.env
#   cp configs/celatlas.env.example celatlas.local.env
#
# Or point to any file:
#   export CELATLAS_CONFIG=/path/to/celatlas.env
#
# Shell syntax is used, so quote paths that contain spaces.

# Main data workspace. Input/output subdirectories default under this root.
export CELATLAS_WORKSPACE="${HOME}/celatlas_spatial"

# Data layout. Override only what differs from the default workspace layout.
export CELATLAS_REFERENCE_DIR="${CELATLAS_WORKSPACE}/reference"
export CELATLAS_FFPE_REFERENCE_DIR="${CELATLAS_REFERENCE_DIR}/Homo_sapiens_wtpanel"
export CELATLAS_MASK_DIR="${CELATLAS_WORKSPACE}/ST_mask"
export CELATLAS_IMAGE_DIR="${CELATLAS_WORKSPACE}/images"
export CELATLAS_FASTQ_ROOT="${CELATLAS_WORKSPACE}/fastq"
export CELATLAS_RESULTS_ROOT="${CELATLAS_WORKSPACE}/results"
export CELATLAS_SRC_DIR="${CELATLAS_WORKSPACE}/src"
export CELATLAS_BINSEGMENT_ROOT="${CELATLAS_WORKSPACE}/binSegment"

# Spatial runtime inputs are staged under each result directory:
#   <result>/<case>/<sample>/06.segment/mask
# Put manual masks there as manual_mask.png and he_manual_mask.png.

# On FASTQ changes or supplementary sequencing reruns, stale sequencing-derived
# outputs are removed by default. Set to 1 only when old outputs must be kept.
# export CELATLAS_RERUN_ARCHIVE=1

# Unified runtime environment.
export CELATLAS_ENV_NAME="celatlas18"
# Optional. Usually auto-detected from an active conda install or $HOME/miniforge3.
# export CELATLAS_CONDA_ROOT="${HOME}/miniforge3"
# export CELATLAS_ENV_PREFIX="${CELATLAS_CONDA_ROOT}/envs/${CELATLAS_ENV_NAME}"

# Set to 1 if scripts should activate CELATLAS_ENV_NAME automatically.
export CELATLAS_AUTO_ACTIVATE=0

# Set to 1 if command lookup should prefer the unified environment bin directory.
export CELATLAS_USE_ENV_PATH=0

# Optional FFPE/probe STAR multi-mapping cap. Leave unset to use script defaults
# (10 for FFPE spatial/probe mode, 1 for scrna).
# export CELATLAS_STAR_MULTIMAP=10

# Optional local StarDist model cache. If unset, StarDist can use its own cache.
# export CELATLAS_STARDIST_MODEL_DIR="${HOME}/.keras/models/StarDist2D/2D_versatile_he/2D_versatile_he_extracted"

# Optional report generator overrides. Normally the scripts use package-local tools.
# export CELATLAS_SPATIAL_REPORT_GENERATOR="/path/to/spatial_report_generator.py"
# export CELATLAS_SCRNA_REPORT_GENERATOR="/path/to/scrna_report_generator.py"

# Production integration:
# PMSystem or another scheduler should point CELATLAS_CONFIG to this file and
# call `Celatlas_run.sh CONFIG <job.env>`. Keep account-specific paths here,
# and keep sample-specific parameters in each job.env file.
