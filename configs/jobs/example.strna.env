# Example per-job config for Celatlas_run.sh CONFIG mode.
# Copy this file per sample/job and edit the values below.

export CELATLAS_RUN_WORKFLOW="FF"

export CELATLAS_SAMPLE_NAME="test"
export CELATLAS_CHIP_NUMBER="ST110250_A1"
export CELATLAS_CASNO="prod_case"
export CELATLAS_CHEMISTRY="BBV2.4"
export CELATLAS_SPECIES="Mus_musculus"
export CELATLAS_METHOD="gene_expr"
export CELATLAS_MODE="strna"

export CELATLAS_THREAD="32"
export CELATLAS_BIN="50"
export CELATLAS_PIXEL_SIZE="0.5"

# Optional per-job path overrides. Prefer keeping machine/account paths in
# configs/celatlas.env unless a specific job needs a different directory.
# export CELATLAS_FASTQ_DIR="/mnt/strna/celatlas_spatial/fastq/BBV2.4"
# export CELATLAS_FASTQ_NAME="ST110250_A1"
# export CELATLAS_MASK_DIR="/mnt/strna/celatlas_spatial/ST_mask"
# export CELATLAS_IMAGE_DIR="/mnt/strna/celatlas_spatial/images"
# export CELATLAS_REFERENCE_DIR="/mnt/strna/celatlas_spatial/reference"

# Common production switches.
export CELATLAS_RESUME_EXISTING="0"
export CELATLAS_GENE_MASK_FILTER="0"
export CELATLAS_ENABLE_CAVITY_FILTER="0"
export CELATLAS_ENABLE_STARDIST_CELL_SEGMENT="0"

# Extra args are optional. Use a bash array when values may contain spaces.
# CELATLAS_EXTRA_ARGS=(--cavity-mask-preset adipose)
