include configs/jobs/example.strna.env
recursive-include deploy/release *
include docs/celatlas_spatial_manual_zh.md
include docs/celatlas_spatial_manual_en.md
include docs/linux_deployment_guide.md
recursive-include envs *
include scripts/README.md
include scripts/background_swap/*.py
include scripts/background_swap/requirements.txt
include scripts/roi_cropper/*.py
include scripts/roi_cropper/*.json
include scripts/analyze_sequencing_saturation.py
include scripts/celatlas_config.sh
